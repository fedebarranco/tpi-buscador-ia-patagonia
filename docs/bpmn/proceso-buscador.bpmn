<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="http://tpi.local/bpmn">
<collaboration id="col">
<participant id="P_cli" name="Patagonia Argentina (cliente)" processRef="Proc_cli"/>
<participant id="P_eq" name="Equipo de desarrollo" processRef="Proc_eq"/>
<participant id="P_ext" name="Desarrollador externo (tercerizado)" processRef="Proc_ext"/>
<messageFlow id="m1" name="pedido" sourceRef="C0" targetRef="R1"/>
<messageFlow id="m2" name="alternativas" sourceRef="R2" targetRef="C1"/>
<messageFlow id="m3" name="decisión" sourceRef="C1" targetRef="D1"/>
<messageFlow id="m4" name="cambios a migrar" sourceRef="D1" targetRef="E1"/>
<messageFlow id="m5" name="migración lista" sourceRef="E1" targetRef="D2"/>
<messageFlow id="m6" name="pedido de OK" sourceRef="D5" targetRef="C2"/>
<messageFlow id="m7" name="OK" sourceRef="C2" targetRef="D3"/>
<messageFlow id="m8" name="errores" sourceRef="D4" targetRef="E2"/>
<messageFlow id="m9" name="corrección" sourceRef="E2" targetRef="D4"/>
</collaboration>
<process id="Proc_cli" isExecutable="false">
<startEvent id="C0" name="Pide mejorar el buscador"><outgoing>s1</outgoing></startEvent>
<task id="C1" name="Elegir una opción"><incoming>s1</incoming><outgoing>s2</outgoing></task>
<task id="C2" name="Dar el OK"><incoming>s2</incoming><outgoing>s3</outgoing></task>
<endEvent id="C3" name="Buscador con IA en el sitio"><incoming>s3</incoming></endEvent>
<sequenceFlow id="s1" name="" sourceRef="C0" targetRef="C1"/>
<sequenceFlow id="s2" name="" sourceRef="C1" targetRef="C2"/>
<sequenceFlow id="s3" name="" sourceRef="C2" targetRef="C3"/>
</process>
<process id="Proc_eq" isExecutable="false">
<laneSet id="ls">
<lane id="L_rel" name="Relación con el cliente e investigación"><flowNodeRef>R1</flowNodeRef><flowNodeRef>R2</flowNodeRef><flowNodeRef>R3</flowNodeRef><flowNodeRef>R4</flowNodeRef></lane>
<lane id="L_des" name="Desarrollo"><flowNodeRef>D1</flowNodeRef><flowNodeRef>D2</flowNodeRef><flowNodeRef>G1</flowNodeRef><flowNodeRef>D5</flowNodeRef><flowNodeRef>D3</flowNodeRef><flowNodeRef>D4</flowNodeRef></lane>
<lane id="L_sis" name="Sistema (Boost Turbo)"><flowNodeRef>S1</flowNodeRef></lane>
</laneSet>
<task id="R1" name="Relevar el pedido e investigar las opciones"><outgoing>s4</outgoing></task>
<task id="R2" name="Presentar las alternativas"><incoming>s4</incoming><outgoing>s5</outgoing></task>
<task id="R3" name="Hacer el seguimiento y cerrar con el jefe"><incoming>s13</incoming><outgoing>s14</outgoing></task>
<endEvent id="R4" name="Proyecto cerrado"><incoming>s14</incoming></endEvent>
<task id="D1" name="Mapear cambios y riesgos de pasar a Turbo"><incoming>s5</incoming><outgoing>s6</outgoing></task>
<task id="D2" name="Revisar en el theme oculto"><incoming>s6</incoming><incoming>s11</incoming><outgoing>s7</outgoing></task>
<exclusiveGateway id="G1" name="¿Funciona y es compatible?"><incoming>s7</incoming><outgoing>s8</outgoing><outgoing>s9</outgoing></exclusiveGateway>
<task id="D5" name="Pedir el OK al cliente"><incoming>s8</incoming><outgoing>s10</outgoing></task>
<task id="D3" name="Pasar a producción (nunca un viernes)"><incoming>s10</incoming><outgoing>s12</outgoing></task>
<task id="D4" name="Pasar los errores al externo"><incoming>s9</incoming><outgoing>s11</outgoing></task>
<serviceTask id="S1" name="Interpretar la búsqueda con IA y guardar los datos"><incoming>s12</incoming><outgoing>s13</outgoing></serviceTask>
<sequenceFlow id="s4" name="" sourceRef="R1" targetRef="R2"/>
<sequenceFlow id="s5" name="" sourceRef="R2" targetRef="D1"/>
<sequenceFlow id="s6" name="" sourceRef="D1" targetRef="D2"/>
<sequenceFlow id="s7" name="" sourceRef="D2" targetRef="G1"/>
<sequenceFlow id="s8" name="Sí" sourceRef="G1" targetRef="D5"/>
<sequenceFlow id="s9" name="No" sourceRef="G1" targetRef="D4"/>
<sequenceFlow id="s10" name="" sourceRef="D5" targetRef="D3"/>
<sequenceFlow id="s11" name="" sourceRef="D4" targetRef="D2"/>
<sequenceFlow id="s12" name="" sourceRef="D3" targetRef="S1"/>
<sequenceFlow id="s13" name="" sourceRef="S1" targetRef="R3"/>
<sequenceFlow id="s14" name="" sourceRef="R3" targetRef="R4"/>
</process>
<process id="Proc_ext" isExecutable="false">
<task id="E1" name="Migrar a Turbo y configurar la IA"></task>
<task id="E2" name="Corregir errores (con el soporte de la app)"></task>
</process>
