<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="http://tpi.local/bpmn">
<collaboration id="col">
<participant id="P_cli" name="Cliente" processRef="Proc_cli"/>
<participant id="P_sis" name="Sistema de la tienda" processRef="Proc_sis"/>
<participant id="P_pag" name="Pasarela de pagos" processRef="Proc_pag"/>
<messageFlow id="m1" name="búsqueda" sourceRef="C0" targetRef="S1"/>
<messageFlow id="m2" name="resultados" sourceRef="S4" targetRef="C1"/>
<messageFlow id="m3" name="elegido" sourceRef="C1" targetRef="T1"/>
<messageFlow id="m4" name="pedido" sourceRef="T3" targetRef="P1"/>
<messageFlow id="m5" name="resultado del pago" sourceRef="P1" targetRef="T3"/>
<messageFlow id="m6" name="confirmación" sourceRef="T5" targetRef="C2"/>
<messageFlow id="m7" name="motivo" sourceRef="T6" targetRef="C2"/>
</collaboration>
<process id="Proc_cli" isExecutable="false">
<startEvent id="C0" name="Escribe lo que busca"><outgoing>s1</outgoing></startEvent>
<task id="C1" name="Elegir un producto, talle y color"><incoming>s1</incoming><outgoing>s2</outgoing></task>
<task id="C2" name="Ver el resultado de la compra"><incoming>s2</incoming><outgoing>s3</outgoing></task>
<endEvent id="C3" name="Fin"><incoming>s3</incoming></endEvent>
<sequenceFlow id="s1" name="" sourceRef="C0" targetRef="C1"/>
<sequenceFlow id="s2" name="" sourceRef="C1" targetRef="C2"/>
<sequenceFlow id="s3" name="" sourceRef="C2" targetRef="C3"/>
</process>
<process id="Proc_sis" isExecutable="false">
<laneSet id="ls">
<lane id="L_bus" name="Buscador (Boost Turbo con IA)"><flowNodeRef>S1</flowNodeRef><flowNodeRef>S2</flowNodeRef><flowNodeRef>G1</flowNodeRef><flowNodeRef>S3</flowNodeRef><flowNodeRef>S4</flowNodeRef><flowNodeRef>S5</flowNodeRef><flowNodeRef>S6</flowNodeRef></lane>
<lane id="L_tie" name="Tienda (Shopify: stock y pedidos)"><flowNodeRef>T1</flowNodeRef><flowNodeRef>G2</flowNodeRef><flowNodeRef>T3</flowNodeRef><flowNodeRef>G3</flowNodeRef><flowNodeRef>T4</flowNodeRef><flowNodeRef>T5</flowNodeRef><flowNodeRef>T6</flowNodeRef></lane>
</laneSet>
<serviceTask id="S1" name="Interpretar la búsqueda con IA"><outgoing>s4</outgoing></serviceTask>
<serviceTask id="S2" name="Buscar productos disponibles según los gustos del cliente"><incoming>s4</incoming><outgoing>s5</outgoing></serviceTask>
<exclusiveGateway id="G1" name="¿Hay resultados?"><incoming>s5</incoming><outgoing>s6</outgoing><outgoing>s7</outgoing></exclusiveGateway>
<serviceTask id="S3" name="Sugerir productos similares"><incoming>s7</incoming><outgoing>s8</outgoing></serviceTask>
<serviceTask id="S4" name="Mostrar resultados y productos que combinan"><incoming>s6</incoming><incoming>s8</incoming><outgoing>s9</outgoing></serviceTask>
<serviceTask id="S5" name="Guardar los datos de la búsqueda"><incoming>s9</incoming><outgoing>s10</outgoing></serviceTask>
<endEvent id="S6" name="Búsqueda registrada"><incoming>s10</incoming></endEvent>
<serviceTask id="T1" name="Verificar el stock del producto elegido"><outgoing>s11</outgoing></serviceTask>
<exclusiveGateway id="G2" name="¿Hay stock?"><incoming>s11</incoming><outgoing>s12</outgoing><outgoing>s13</outgoing></exclusiveGateway>
<serviceTask id="T3" name="Registrar el pedido y cobrar"><incoming>s12</incoming><outgoing>s14</outgoing></serviceTask>
<exclusiveGateway id="G3" name="¿Pago aprobado?"><incoming>s14</incoming><outgoing>s15</outgoing><outgoing>s16</outgoing></exclusiveGateway>
<serviceTask id="T4" name="Descontar el stock"><incoming>s15</incoming><outgoing>s17</outgoing></serviceTask>
<serviceTask id="T5" name="Confirmar la compra al cliente"><incoming>s17</incoming></serviceTask>
<serviceTask id="T6" name="Informar el motivo (sin stock o pago rechazado)"><incoming>s13</incoming><incoming>s16</incoming></serviceTask>
<sequenceFlow id="s4" name="" sourceRef="S1" targetRef="S2"/>
<sequenceFlow id="s5" name="" sourceRef="S2" targetRef="G1"/>
<sequenceFlow id="s6" name="Sí" sourceRef="G1" targetRef="S4"/>
<sequenceFlow id="s7" name="No" sourceRef="G1" targetRef="S3"/>
<sequenceFlow id="s8" name="" sourceRef="S3" targetRef="S4"/>
<sequenceFlow id="s9" name="" sourceRef="S4" targetRef="S5"/>
<sequenceFlow id="s10" name="" sourceRef="S5" targetRef="S6"/>
<sequenceFlow id="s11" name="" sourceRef="T1" targetRef="G2"/>
<sequenceFlow id="s12" name="Sí" sourceRef="G2" targetRef="T3"/>
<sequenceFlow id="s13" name="No" sourceRef="G2" targetRef="T6"/>
<sequenceFlow id="s14" name="" sourceRef="T3" targetRef="G3"/>
<sequenceFlow id="s15" name="Sí" sourceRef="G3" targetRef="T4"/>
<sequenceFlow id="s16" name="" sourceRef="G3" targetRef="T6"/>
<sequenceFlow id="s17" name="" sourceRef="T4" targetRef="T5"/>
</process>
<process id="Proc_pag" isExecutable="false">
<task id="P1" name="Procesar el pago"></task>
</process>
